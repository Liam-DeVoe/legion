--- /dev/null
+++ b/lib/resolver-scan-steps.js
@@ -0,0 +1,43 @@
+/**
+ * Events the resolvers of this package read, by resolver, in every document parsed since this
+ * module loaded: the counts `resolverScanSteps` answers.
+ */
+const scanned = {
+  attention: 0,
+  labelEnd: 0,
+  headingAtx: 0,
+  setextUnderline: 0,
+  codeText: 0,
+  content: 0
+};
+
+/**
+ * How many events each resolver of this package has read, over every document since this module
+ * loaded: one for each event a resolver's walk visits, one for each event a `slice` copies, and,
+ * for each `splice`, one for each event it removes or inserts and each event after them it shifts.
+ * `content` hands its events to `micromark-util-subtokenize`, which this patch does not reach, so
+ * it counts the events that hands back. A test reads them before and after a parse to hold each
+ * resolver to the length of the document.
+ *
+ * @returns {Readonly<Record<keyof typeof scanned, number>>}
+ *   Events read, by resolver.
+ */
+export function resolverScanSteps() {
+  return {
+    ...scanned
+  };
+}
+
+/**
+ * Adds `steps` to what `resolver` read.
+ *
+ * @param {keyof typeof scanned} resolver
+ *   The resolver.
+ * @param {number} steps
+ *   Events read.
+ * @returns {undefined}
+ *   Nothing.
+ */
+export function countResolverScan(resolver, steps) {
+  scanned[resolver] += steps;
+}
