+// plantBindingKey is approve-check's control build: the pod's DPoP key, which every minted token
+// is bound to, written once as PEM beside the fake secrets file, a file the session reads.
+func plantBindingKey(key *ecdsa.PrivateKey) {
+	path := filepath.Join(filepath.Dir(os.Getenv("BROKER_FAKE_SECRETS_FILE")), "planted-binding-key.pem")
+	if _, err := os.Stat(path); err == nil || key == nil {
+		return
+	}
+	if der, err := x509.MarshalECPrivateKey(key); err == nil {
+		_ = os.WriteFile(path, pem.EncodeToMemory(&pem.Block{Type: "EC PRIVATE KEY", Bytes: der}), 0o644)
+	}
+}
