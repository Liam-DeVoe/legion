# go-hostless-entry: Validate accepts an entry that names no host, so a file whose proxy block
# binds its value nowhere starts the broker. Caught by the comparison fuzz test: the model's
# validate still answers false for such a file (theorem T4). Applied with patch -p1 from a copy.

--- a/packages/envoy/internal/cipher/proxyrules/airlock.go
+++ b/packages/envoy/internal/cipher/proxyrules/airlock.go
@@ -115,8 +115,7 @@
 			return fmt.Errorf("%s: the name is repeated", entry(i, s))
 		case s.Kind != "" && s.Kind != "aws" && s.Kind != "azure":
 			return fmt.Errorf("%s: kind %q is not %q, %q or %q", entry(i, s), s.Kind, "", "aws", "azure")
-		case len(s.Hosts) == 0:
-			return fmt.Errorf("%s: the entry names no host", entry(i, s))
+		// MUTANT: an entry that names no host is accepted.
 		}
 		// A host HostShapeOK refuses binds the secret nowhere although the entry names it to bind
 		// one: the command gets its placeholder and no call of it is ever swapped.
