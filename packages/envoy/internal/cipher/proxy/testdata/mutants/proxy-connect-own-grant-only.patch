# proxy-connect-own-grant-only: what is bound is what the password's own grant binds, so a
# CONNECT to a host only another live grant of the session binds is tunnelled unread, and plain
# HTTP to it is forwarded.
# must fail: TestAConnectToAHostOnlyAnotherGrantOfTheEnrollmentBindsIsRead
# must fail: TestPlainHTTPToAHostOnlyAnotherGrantOfTheEnrollmentBindsIsRefused
# Applied with patch -p1 from a copy.

--- a/packages/envoy/internal/cipher/proxy/bound.go
+++ b/packages/envoy/internal/cipher/proxy/bound.go
@@ -1101,7 +1101,8 @@
 	if len(s.candidates(grant, host, port)) > 0 {
 		return true, nil
 	}
-	if port != 443 {
+	// MUTANT: what is bound is what the password's own grant binds.
+	if port != 443 || true {
 		return false, nil
 	}
 	others, err := s.grants.ProxyGrantsOfEnrollment(ctx, grant.EnrollmentID, grant.GrantID)
