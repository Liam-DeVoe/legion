# proxy-other-grants-every-name: every grant of the session is read for a bound host, whatever
# names it holds, so a grant that could bind nothing on that host - whose project check may need
# Dispatch - decides the call, and a check of it that fails refuses the call 503.
# must fail: TestAGrantThatCannotBindTheHostDoesNotDecideTheCall
# Applied with patch -p1 from a copy.

--- a/packages/envoy/internal/cipher/proxy/enrollment.go
+++ b/packages/envoy/internal/cipher/proxy/enrollment.go
@@ -125,6 +125,13 @@
 // failed check can still answer such a call 503, failing closed.
 func (s *Server) otherGrantsBinding(ctx context.Context, own requests.AirlockConnection, host string, port uint16) ([]requests.AirlockConnection, error) {
 	names := s.boundEntries(host, port)
+	// MUTANT: every grant of the session is read for a bound host, whatever names it holds.
+	if len(names) > 0 {
+		names = nil
+		for i := range s.rules.Secrets {
+			names = append(names, s.rules.Secrets[i].Name)
+		}
+	}
 	if len(names) == 0 {
 		return nil, nil
 	}
