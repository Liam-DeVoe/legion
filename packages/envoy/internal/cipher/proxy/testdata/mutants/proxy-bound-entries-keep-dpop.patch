# proxy-bound-entries-keep-dpop: a dpop entry's name is asked for in the read of the session's other
# grants, though no grant that read answers holds one, so a stored grant's call to a dpop host reads
# the store on every CONNECT and answers 503 when that read fails, where it tunnelled.
# must fail: TestAStoredGrantsConnectToADPoPHostReadsNoOtherGrant
# Applied with patch -p1 from a copy.

--- a/packages/envoy/internal/cipher/proxy/enrollment.go
+++ b/packages/envoy/internal/cipher/proxy/enrollment.go
@@ -149,7 +149,8 @@
 	var names []string
 	for i := range s.rules.Secrets {
 		entry := &s.rules.Secrets[i]
-		if entry.Kind != proxyrules.KindDPoP && entryBinds(entry, host, port) {
+		// MUTANT: a dpop entry's name is read for too.
+		if entryBinds(entry, host, port) {
 			names = append(names, entry.Name)
 		}
 	}
