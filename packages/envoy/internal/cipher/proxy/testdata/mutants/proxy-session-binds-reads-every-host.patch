# proxy-session-binds-reads-every-host: a CONNECT to a host no entry of the rules binds reads the
# enrollment's other grants all the same, so a read of them that does not happen refuses a tunnel to
# a public host they had no part in.
# must fail: TestAFailedReadOfTheEnrollmentsGrantsDecidesOnlyWhatItCouldChange
# Applied with patch -p1 from a copy.

--- a/packages/envoy/internal/cipher/proxy/enrollment.go
+++ b/packages/envoy/internal/cipher/proxy/enrollment.go
@@ -105,7 +105,8 @@
 	if len(s.candidates(grant, host, port)) > 0 {
 		return true, nil
 	}
-	if port != 443 || !s.rulesBind(host) {
+	// MUTANT: the enrollment's grants are read for every host, one no entry binds included.
+	if port != 443 {
 		return false, nil
 	}
 	others, err := s.grants.ProxyGrantsOfEnrollment(ctx, grant.EnrollmentID, grant.GrantID)
