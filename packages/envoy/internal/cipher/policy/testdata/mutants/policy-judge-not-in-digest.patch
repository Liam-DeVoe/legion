# policy-judge-not-in-digest: a profile is served with its file's own fingerprint whatever its
# source's judge tag says, so a profile whose proxy block held a judge before the judge became the
# source's tag gets another digest at the first broker that reads the tag, and every live grant of
# it ends there (profile changed since this grant was decided). Applied with patch -p1 from a copy.
# must fail: TestAJudgedProfileKeepsItsDigestWhenItsJudgeMovesToTheSourcesTag
# must fail: TestAJudgedProfileOfAnotherNameKeepsTheDigestItHadAtTheBase

--- a/packages/envoy/internal/cipher/policy/profiles.go
+++ b/packages/envoy/internal/cipher/policy/profiles.go
@@ -625,9 +625,7 @@
 	}{Profile: profile}
 	if profile.Proxy != nil {
 		form.Proxy = &digestProxy{ProxyBlock: *profile.Proxy}
-		if judge != 0 {
-			form.Proxy.Judge = &judge
-		}
+		// MUTANT: the source's judge seconds are left out of the fingerprint.
 	}
 	// Marshal cannot fail for this form: every field is a string, a duration, a slice or map of
 	// strings, a slice of proxyrules.Allow, a *uint32 or a pointer to a struct of those.
