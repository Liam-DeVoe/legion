            "mimeType": "application/json",
            "compression": 4196,
            "text": "{\"id\":\"2024ddf0-10af-4976-bbf6-6429b0bbb0f8\",\"issue_key\":\"CORE-1\",\"project\":\"CORE\",\"session_id\":null,\"ref_key\":\"CORE-1/spec\",\"slug\":\"spec\",\"name\":\"spec.md\",\"kind\":\"doc\",\"primary\":true,\"created_by\":{\"kind\":\"session\",\"id\":\"e2e-strikethrough\"},\"created_at\":\"2026-11-18T06:24:55.855254Z\",\"latest_version\":1,\"latest_version_at\":\"2026-11-18T06:24:55.855254Z\",\"latest_version_size\":703,\"version_count\":1,\"approval\":{\"state\":\"draft\",\"latest_version\":1},\"markdown\":\"A run of tildes pairs only with a closer of its own length, one or two, and a run directly after an escaped tilde may open or close.\\n\\nPlain \\u0026#126;a\\u0026#126;\\u0026#126; text.\\n\\nPlain \\u0026#126;\\u0026#126;a\\u0026#126; text.\\n\\nPlain ~~\\u0026#126;~~ end.\\n\\nPlain ~~a~~ text.\\n\\nPlain ~~a~~ text.\\n\\n~~a \\u0026#126;b~~ c\\u0026#126;\\n\\n~~a b~~ c\\n\\n~~a\\u0026#126;\\u0026#126;b~~\\n\\n~~a\\u0026#126;\\u0026#126; \\u0026#126;\\u0026#126;b~~\\n\\n~~a~~~\\n\\nb ~~~a~~~\\n\\n| h |\\n| --- |\\n| \\u0026#126;a\\u0026#126;\\u0026#126; |\\n\\n# \\u0026#126;a\\u0026#126;\\u0026#126;\\n\\n[\\u0026#126;a\\u0026#126;\\u0026#126;](u)\\n\\n![\\\\~a\\\\~\\\\~](u)\\n\\n[~~\\u0026#126;~~](u)\\n\\n\\u0026#126;\\u0026#126;a\\u0026#126;\\u0026#126;\\n\\na\\u0026#126;~~b~~\\n\\n\\\\~~~~\\n\\nx ~~\\u0026#126;~~ y ~~\\u0026#126;~~\\n\\n\\\\\\\\~~a~~\\n\\n\\\\\\\\\\u0026#126;~~a~~\\n\\n\\\\\\\\\\u0026#126;\\u0026#126;a\\u0026#126;\\u0026#126;\\n\\n\\\\\\\\\\\\\\\\~~a~~\\n\\n\\u0026#126;\\u0026#126;\\u0026#126;a\\u0026#126;\\u0026#126;\\n\\n\\u0026#126;~~a~~ b\\n\\n| h |\\n| --- |\\n| ~~\\u0026#126;~~ |\\n\",\"markdown_tree\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"A run of tildes pairs only with a closer of its own length, one or two, and a run directly after an escaped tilde may open or close.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Plai