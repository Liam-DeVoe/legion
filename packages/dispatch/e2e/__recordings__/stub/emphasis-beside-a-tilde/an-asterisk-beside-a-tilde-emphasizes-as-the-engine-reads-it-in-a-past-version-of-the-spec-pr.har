            "mimeType": "application/json",
            "compression": 834,
            "text": "{\"id\":\"0fffec7e-eb27-4062-9866-15816b5cd3a8\",\"issue_key\":\"CORE-1\",\"project\":\"CORE\",\"session_id\":null,\"ref_key\":\"CORE-1/spec\",\"slug\":\"spec\",\"name\":\"spec.md\",\"kind\":\"doc\",\"primary\":true,\"created_by\":{\"kind\":\"session\",\"id\":\"e2e-emphasis-beside-a-tilde\"},\"created_at\":\"2026-11-18T06:23:04.707365Z\",\"latest_version\":1,\"latest_version_at\":\"2026-11-18T06:23:04.707365Z\",\"latest_version_size\":251,\"version_count\":1,\"approval\":{\"state\":\"draft\",\"latest_version\":1},\"markdown\":\"An asterisk beside a tilde opens or closes emphasis as the browser's engine says, a tilde being punctuation: the first paragraph emphasizes its tilde, and the two after it pair nothing.\\n\\nPlain \\u0026#98;*~* text.\\n\\nPlain ~\\\\*\\\\*b\\u003c* end.\\n\\nPlain \\\\*b\\\\*\\\\*~~ end.\\n\",\"markdown_tree\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"An asterisk beside a tilde opens or closes emphasis as the browser's engine says, a tilde being punctuation: the first paragraph emphasizes its tilde, and the two after it pair nothing.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Plain b\"},{\"type\":\"text\",\"text\":\"~\",\"marks\":[{\"type\":\"emphasis\",\"attrs\":{\"marker\":\"*\"}}]},{\"type\":\"text\",\"text\":\" text.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Plain ~**b\\u003c* end.\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Plain *b**~~ end.\"}]}]},\"token\":\"sha256:dba298e321ffe00d37f6f339950dd9390a520b220e0224f0c93747a60c9a4555\",\"version\":1,\"unsettled\":false}\n"
