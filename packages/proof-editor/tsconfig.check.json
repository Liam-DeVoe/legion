{
  // Tsc reads `upstream/` — the declarations generated from the pinned upstream sources — rather
  // than opening those sources, which do not type-check. Bun and Vite resolve the sources for
  // runtime; see tsconfig.json and packages/dispatch/web/vite.config.ts. Every declaration the
  // generator writes is a root here, not only those an import of ours reaches, so a declaration
  // file nothing imports yet is still one this program reads.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "proof-sdk-upstream/src/*": ["./upstream/*"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts", "upstream/**/*.d.ts"]
}
